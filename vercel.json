{
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/(.*\\.(jpg|jpeg|png|ico|svg|webp|json|webmanifest|css|js))", "dest": "/public/$1" },
    { "src": "/(.*\\.html)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "index.html" }
  ]
}
